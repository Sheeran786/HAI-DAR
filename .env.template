# Frontend environment variables — TEMPLATE ONLY
# Copy this file to `.env` and fill in real values.
# NOTE: The variables that start with EXPO_PACKAGER_* / EXPO_TUNNEL_* / METRO_* are
# generated by the Emergent preview environment. When you run the app locally or on
# your own host you can leave them empty (or delete them) — only EXPO_PUBLIC_BACKEND_URL
# is required at runtime by the frontend code.

# Base URL the frontend uses to talk to the FastAPI backend.
# In dev this is typically http://localhost:8001 ; in production the public HTTPS URL of your API.
# The client automatically appends `/api/...` to this base.
EXPO_PUBLIC_BACKEND_URL=

# Emergent-managed values (leave blank when self-hosting)
EXPO_TUNNEL_SUBDOMAIN=
EXPO_PACKAGER_HOSTNAME=
EXPO_PACKAGER_PROXY_URL=
EXPO_USE_FAST_RESOLVER=
METRO_CACHE_ROOT=
